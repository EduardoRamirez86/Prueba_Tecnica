{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS_HERE",
    "Issuer": "ConsultoriaAPI",
    "Audience": "ConsultoriaAPI-Clients",
    "ExpirationMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=ConsultoriaDb;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
