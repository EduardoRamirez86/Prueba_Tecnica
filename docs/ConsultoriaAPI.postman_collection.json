        {
          "name": "POST Consultor - Negative Test (Validation 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Content-Type is application/problem+json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Consultor Inválido\",\n  \"emailCorporativo\": \"invalido@consultoria.local\",\n  \"tarifaHora\": 25.00,\n  \"cantidadProyectosActivos\": 6,\n  \"areaEspecializacion\": \"N/A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/consultores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "consultores"
              ]
            },
            "description": "Prueba de validación. La tarifa está por debajo del mínimo (30.00) y los proyectos exceden el máximo (5). Se espera un 400 Bad Request en formato RFC 7807 (problem+json)."
          },
          "response": []
        },
        {
          "name": "POST Consultor - Negative Test (403 Forbidden User Role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Consultor No Autorizado\",\n  \"emailCorporativo\": \"noauth@consultoria.local\",\n  \"tarifaHora\": 50.00,\n  \"cantidadProyectosActivos\": 1,\n  \"areaEspecializacion\": \"DevOps\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/consultores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "consultores"
              ]
            },
            "description": "Intenta crear un consultor utilizando el token de un usuario con rol 'User'. Se espera que sea rechazado con 403 Forbidden por RBAC."
          },
          "response": []
        }
      ]
    },
